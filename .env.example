# PostgreSQL connection string
DATABASE_URL="postgresql://etcomp_user:CHANGE_ME@localhost:5432/etcomp?schema=public"

# Secret used to sign admin session JWTs — generate a long random value
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"

# Public site URL used for SEO (sitemap.xml, robots.txt, OG tags)
NEXT_PUBLIC_SITE_URL="https://etcom.app.re.kr"

# Port the Next.js server listens on (PM2 sets this)
PORT=3000
NODE_ENV=production

# Used only by `npm run db:seed` to create the first admin account
SEED_ADMIN_EMAIL="admin@etcompany.co.kr"
SEED_ADMIN_PASSWORD="CHANGE_ME"

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Product {
  id             String   @id @default(cuid())
  thumbnailUrl   String?
  titleKo        String
  titleEn        String
  descriptionKo  String   @db.Text
  descriptionEn  String   @db.Text
  categoryKo     String?
  categoryEn     String?
  price          Int?
  isPublished    Boolean  @default(true)
  order          Int      @default(0)
  seoTitle       String?
  seoDescription String?
  slug           String?  @unique
  canonicalUrl   String?
  ogTitle        String?
  ogDescription  String?
  noIndex        Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  images         ImageAsset[]

  @@index([isPublished, order])
}

model PromotionCategory {
  id     String          @id @default(cuid())
  slug   String          @unique
  nameKo String
  nameEn String
  order  Int             @default(0)
  posts  PromotionPost[]
}

model PromotionPost {
  id             String            @id @default(cuid())
  categoryId     String
  category       PromotionCategory @relation(fields: [categoryId], references: [id])
  thumbnailUrl   String?
  titleKo        String
  titleEn        String
  contentKo      String            @db.Text
  contentEn      String            @db.Text
  isPublished    Boolean           @default(true)
  seoTitle       String?
  seoDescription String?
  slug           String?            @unique
  canonicalUrl   String?
  ogTitle        String?
  ogDescription  String?
  noIndex        Boolean            @default(false)
  publishedAt    DateTime          @default(now())
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  images         ImageAsset[]

  @@index([categoryId, isPublished, publishedAt])
}

model ImageAsset {
  id              String         @id @default(cuid())
  fileName        String
  mimeType        String
  size            Int
  data            Bytes
  order           Int            @default(0)
  productId       String?
  product         Product?       @relation(fields: [productId], references: [id], onDelete: Cascade)
  promotionPostId String?
  promotionPost   PromotionPost? @relation(fields: [promotionPostId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())

  @@index([productId, order])
  @@index([promotionPostId, order])
}

model ContactInquiry {
  id         String    @id @default(cuid())
  type       String    @default("general") // general | product
  name       String
  company    String?
  email      String
  phone      String?
  message    String    @db.Text
  status     String    @default("new") // new | in_progress | done
  reply      String?   @db.Text
  repliedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([type, status, createdAt])
}

model PageVisit {
  id        String   @id @default(cuid())
  path      String
  locale    String   @default("ko")
  createdAt DateTime @default(now())

  @@index([path, createdAt])
}

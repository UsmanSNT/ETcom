generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Product {
  id             String   @id @default(cuid())
  thumbnailUrl   String?
  titleKo        String
  titleEn        String
  descriptionKo  String   @db.Text
  descriptionEn  String   @db.Text
  categoryKo     String?
  categoryEn     String?
  categoryId     String?
  category       ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  price          Int?
  purchaseUrl    String?
  isPublished    Boolean  @default(true)
  order          Int      @default(0)
  seoTitle       String?
  seoDescription String?
  slug           String?  @unique
  canonicalUrl   String?
  ogTitle        String?
  ogDescription  String?
  noIndex        Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  images         ImageAsset[]    @relation("ProductGallery")
  detailImages   ImageAsset[]    @relation("ProductDetail")
  reviews        ProductReview[]

  @@index([isPublished, order])
}

model ProductReview {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating     Int
  comment    String?  @db.Text
  authorName String?
  createdAt  DateTime @default(now())

  @@index([productId, createdAt])
}

model ProductCategory {
  id       String            @id @default(cuid())
  nameKo   String
  nameEn   String
  order    Int               @default(0)
  parentId String?
  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children ProductCategory[] @relation("CategoryTree")
  products Product[]

  @@index([order])
  @@index([parentId])
}

model PromotionCategory {
  id     String          @id @default(cuid())
  slug   String          @unique
  nameKo String
  nameEn String
  order  Int             @default(0)
  posts  PromotionPost[]
}

model PromotionPost {
  id             String            @id @default(cuid())
  categoryId     String
  category       PromotionCategory @relation(fields: [categoryId], references: [id])
  thumbnailUrl   String?
  titleKo        String
  titleEn        String
  contentKo      String            @db.Text
  contentEn      String            @db.Text
  isPublished    Boolean           @default(true)
  seoTitle       String?
  seoDescription String?
  slug           String?            @unique
  canonicalUrl   String?
  ogTitle        String?
  ogDescription  String?
  noIndex        Boolean            @default(false)
  publishedAt    DateTime          @default(now())
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  images         ImageAsset[]

  @@index([categoryId, isPublished, publishedAt])
}

model ImageAsset {
  id              String         @id @default(cuid())
  fileName        String
  mimeType        String
  size            Int
  data            Bytes
  imageHash       String?
  order           Int            @default(0)
  productId       String?
  product         Product?       @relation("ProductGallery", fields: [productId], references: [id], onDelete: Cascade)
  detailProductId String?
  detailProduct   Product?       @relation("ProductDetail", fields: [detailProductId], references: [id], onDelete: Cascade)
  promotionPostId String?
  promotionPost   PromotionPost? @relation(fields: [promotionPostId], references: [id], onDelete: Cascade)
  businessAreaId  String?
  businessArea    BusinessArea?  @relation(fields: [businessAreaId], references: [id], onDelete: Cascade)
  keyIndustryId   String?
  keyIndustry     KeyIndustry?   @relation(fields: [keyIndustryId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())

  @@index([productId, order])
  @@index([detailProductId, order])
  @@index([promotionPostId, order])
  @@index([businessAreaId, order])
  @@index([keyIndustryId, order])
}

model ContactInquiry {
  id         String    @id @default(cuid())
  type       String    @default("general") // general | product
  name       String
  company    String?
  email      String
  phone      String?
  message    String    @db.Text
  status     String    @default("new") // new | in_progress | done
  reply      String?   @db.Text
  repliedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([type, status, createdAt])
}

model PageVisit {
  id        String   @id @default(cuid())
  path      String
  locale    String   @default("ko")
  createdAt DateTime @default(now())

  @@index([path, createdAt])
}

model SiteConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model BusinessArea {
  id          String       @id @default(cuid())
  titleKo     String
  titleEn     String
  itemsKo     String[]
  itemsEn     String[]
  icon        String       @default("leaf")
  order       Int          @default(0)
  isPublished Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  images      ImageAsset[]

  @@index([isPublished, order])
}

model KeyIndustry {
  id          String       @id @default(cuid())
  titleKo     String
  titleEn     String
  order       Int          @default(0)
  isPublished Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  images      ImageAsset[]

  @@index([isPublished, order])
}

model Faq {
  id          String   @id @default(cuid())
  questionKo  String
  questionEn  String
  answerKo    String   @db.Text
  answerEn    String   @db.Text
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, order])
}

model DownloadResource {
  id          String   @id @default(cuid())
  slot        String?  @unique
  titleKo     String
  titleEn     String
  fileName    String
  mimeType    String
  size        Int
  data        Bytes
  publishedAt DateTime @default(now())
  isPublished Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, order, publishedAt])
}
